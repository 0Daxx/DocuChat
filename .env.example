# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Demo Mode (when Supabase is not configured)
VITE_DEMO_MODE=true

# ============================================
# FREE TIER API KEYS (3 per provider)
# These are available to all users by default
# ============================================

# Groq API Keys (3 free keys)
# Get from: https://console.groq.com/keys
VITE_GROQ_API_KEY_1=gsk_your_first_groq_key_here
VITE_GROQ_API_KEY_2=gsk_your_second_groq_key_here
VITE_GROQ_API_KEY_3=gsk_your_third_groq_key_here

# Cerebras API Keys (3 free keys)
# Get from: https://cloud.cerebras.ai/
VITE_CEREBRAS_API_KEY_1=csk_your_first_cerebras_key_here
VITE_CEREBRAS_API_KEY_2=csk_your_second_cerebras_key_here
VITE_CEREBRAS_API_KEY_3=csk_your_third_cerebras_key_here

# ============================================
# LOCAL PROVIDER DEFAULT URLs
# Users can modify these in settings
# ============================================

# LM Studio default URL
VITE_LMSTUDIO_DEFAULT_URL=http://localhost:1234/v1

# llama.cpp default URL
VITE_LLAMACPP_DEFAULT_URL=http://localhost:8080/v1
